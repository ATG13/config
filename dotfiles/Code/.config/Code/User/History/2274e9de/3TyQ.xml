<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.no-time-for-caution" path="/org/gnome/shell/extensions/no-time-for-caution/">
    <key name="goal-time" type="x">
      <default>0</default>
      <summary>Goal time</summary>
      <description>Unix timestamp for the countdown goal (in seconds).</description>
    </key>
    <key name="time-unit" type="s">
      <default>"seconds"</default>
      <choices>
        <choice value="hours_minutes"/>
        <choice value="minutes_seconds"/>
        <choice value="years"/>
        <choice value="months"/>
        <choice value="weeks"/>
        <choice value="days"/>
        <choice value="hours"/>
        <choice value="minutes"/>
        <choice value="seconds"/>
      </choices>
      <summary>Time unit</summary>
      <description>The unit to display the countdown in.</description>
    </key>
    <key name="indicator-index" type="i">
      <default>0</default>
      <summary>Indicator index</summary>
      <description>Position index of the indicator in the panel.</description>
    </key>
    <key name="indicator-position" type="s">
      <default>"right"</default>
      <summary>Indicator positiongene
      <description>Position of the indicator in the panel (left, center, right).</description>
    </key>
  </schema>
</schemalist>